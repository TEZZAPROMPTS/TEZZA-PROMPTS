  <script>
    function copyPrompt() {
      const promptText = document.getElementById('promptText').innerText;
      const copyBtn = document.getElementById('copyBtn');
      const btnText = document.getElementById('btnText');

      function triggerSuccess() {
        const originalText = btnText.innerText;
        btnText.innerText = 'Prompt copiado com sucesso!';
        copyBtn.classList.add('copy-success');
        setTimeout(() => {
          btnText.innerText = originalText;
          copyBtn.classList.remove('copy-success');
        }, 3000);
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(promptText).then(triggerSuccess).catch(() => fallbackCopy(promptText));
      } else {
        fallbackCopy(promptText);
      }

      function fallbackCopy(text) {
        try {
          const textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.position = "fixed";
          textArea.style.left = "-9999px";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          const successful = document.execCommand('copy');
          document.body.removeChild(textArea);
          if (successful) triggerSuccess();
        } catch (err) { console.error('Erro ao copiar:', err); }
      }
    }
  </script>
